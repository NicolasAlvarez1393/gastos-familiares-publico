{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.servidor.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "skipLibCheck": true,

    /* Bundler mode (wrangler empaqueta el Worker con esbuild). Sin tipos de Node a propósito: */
    /* el código del servidor corre en Cloudflare, donde no hay Buffer ni process. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["servidor"],
  "exclude": ["servidor/**/*.test.ts"]
}
