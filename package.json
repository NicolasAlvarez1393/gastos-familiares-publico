{
  "name": "gastos-familiares",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-pwa-assets": "pwa-assets-generator",
    "preview": "vite preview",
    "dev:cloudflare": "npm run build && wrangler dev",
    "gate": "npm run build && npm test && npm run lint && npm run format:check",
    "capturas": "vite build && node scripts/e2e/capturas.mjs",
    "e2e": "npm run build && node scripts/e2e/cloudflare.mjs && node scripts/e2e/versiones.mjs",
    "debug": "node scripts/e2e/debug.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.147.0"
  }
}
